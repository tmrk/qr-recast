{
  "name": "QR Recast",
  "short_name": "QR Recast",
  "description": "Rebuild photographed QR codes as clean files, privately on your device.",
  "lang": "en-GB",
  "dir": "ltr",
  "categories": ["utilities", "productivity"],
  "prefer_related_applications": false,
  "id": "/qr-recast/",
  "scope": "/qr-recast/",
  "start_url": "/qr-recast/",
  "display": "standalone",
  "theme_color": "#EFEEE7",
  "background_color": "#EFEEE7",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}

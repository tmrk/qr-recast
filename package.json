{
  "name": "qr-recast",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "npm run format:check && npm run lint && npm run test:unit && npm run build",
    "lint": "eslint . --max-warnings=0 && npm run check:spelling && npm run check:qr-types",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:qr-types": "node scripts/check-qr-types.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check:spelling": "node scripts/check-spelling.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "docx": "^9.7.1",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lz-string": "^1.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "svg2pdf.js": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{css,html,json,md,yml,yaml}": "prettier --write"
  },
  "allowScripts": {
    "core-js": false,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
